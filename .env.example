# ==========================================
# YADU-ENTERPRISES Environment Configuration
# ==========================================

# Production Domain URL (used for canonical links, sitemaps, OpenGraph tags)
NEXT_PUBLIC_SITE_URL=https://yadu-enterprises.com

# Destination email for project quote notifications
CONTACT_NOTIFICATION_EMAIL=aditya43775@gmail.com

# ------------------------------------------
# Contact Form Provider Options (Choose ONE):
# ------------------------------------------

# Option A: Resend API (Recommended for transactional emails - https://resend.com)
# RESEND_API_KEY=re_1234567890abcdef

# Option B: Web3Forms (Zero-backend contact forms - https://web3forms.com)
# WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Option C: Formspree (Form backend - https://formspree.io)
# FORMSPREE_ID=your_form_id

# (If no provider key is configured, inquiries are still logged securely to the server console
# and the user receives a success confirmation with one-click direct WhatsApp & mailto options).
